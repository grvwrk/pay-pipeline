# Copy to .env and fill in real values. .env is git-ignored; this file is committed.
# Anything in config.yaml can also be overridden here by its environment variable
# name (PAYMENT_PROVIDER_MODE, LLM_PROVIDER, DATABASE_URL, PORT, ...).

# --- Razorpay -------------------------------------------------------------
# Test-mode API credentials from https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Required when payment.provider_mode is "razorpay"; leave blank for "simulator".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Must match the secret configured on the webhook in the Razorpay dashboard,
# otherwise every incoming event fails signature verification and is dropped.
RAZORPAY_WEBHOOK_SECRET=

# --- Audit chain ----------------------------------------------------------
# Signs every audit record. Changing this invalidates the signatures on all
# existing records, so keep it stable for the life of a database.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIT_HMAC_SECRET=

# --- Groq LLM -------------------------------------------------------------
# Required when llm.provider is "groq"; leave blank for "deterministic".
GROQ_API_KEY=

# --- Tavily search (optional) --------------------------------------------
TAVILY_API_KEY=
