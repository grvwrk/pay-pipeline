# Agent reasoning: set to groq after adding your key. The default runs
# deterministic offline tests only and never silently calls an LLM.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOOL_ROUNDS=4
# GPT-OSS 20B can use Groq browser_search, but commerce remains catalog-first.
ENABLE_GROQ_BROWSER_SEARCH=false

# Payment: simulator is safe locally. Razorpay mode sends requests to Razorpay
# test-mode REST endpoints using the credentials below.
PAYMENT_PROVIDER_MODE=simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AUDIT_HMAC_SECRET=
